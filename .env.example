DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Settings -> API в Supabase Dashboard. SUPABASE_SERVICE_ROLE_KEY — секрет,
# используется только на сервере (загрузка фото в Storage), никогда не должен
# попадать в клиентский код.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role key из Settings -> API"

# Auth.js (NextAuth v5) — секрет для подписи JWT-сессии. Сгенерировать:
# openssl rand -base64 32
AUTH_SECRET="сгенерировать openssl rand -base64 32"

# Токены WB/Ozon/Яндекс.Маркет здесь больше не нужны — с переходом на
# мультитенантность они вводятся отдельно на компанию через страницу
# «Настройки → Интеграции» в самом приложении, а не через .env.
